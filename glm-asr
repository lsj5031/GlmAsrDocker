#!/bin/bash
# GLM-ASR Global CLI Wrapper
set -e

GLM_ASR_PROJECT_DIR="${GLM_ASR_HOME:-$HOME/.glm-asr}"
GLM_ASR_CONTAINER_NAME="${GLM_ASR_CONTAINER:-glm-asr}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

check_container() {
    if ! docker ps --format '{{.Names}}' | grep -q "^${GLM_ASR_CONTAINER_NAME}$"; then
        echo -e "${RED}Error: Container '${GLM_ASR_CONTAINER_NAME}' is not running${NC}"
        echo -e "${YELLOW}Start with: glm-asr start${NC}"
        return 1
    fi
}

case "${1:-}" in
    transcribe)
        [ -z "$2" ] && { echo "Usage: glm-asr transcribe <file> [options]"; exit 1; }
        check_container || exit 1

        input_file="$2"
        [ ! -f "$input_file" ] && { echo -e "${RED}Error: File not found: $input_file${NC}"; exit 1; }

        filename=$(basename "$input_file")
        container_input="/tmp/${filename}"
        basename_noext="${filename%.*}"
        container_output="/tmp/${basename_noext}.txt"

        echo -e "${GREEN}GLM-ASR Transcription${NC}"
        echo "Input: $input_file ($(du -h "$input_file" | cut -f1))"

        docker cp "$input_file" "${GLM_ASR_CONTAINER_NAME}:${container_input}"
        docker exec "${GLM_ASR_CONTAINER_NAME}" python glm_asr_cli.py transcribe \
            "$container_input" -o "$container_output" "${@:3}"

        output_file="${input_file%.*}.txt"
        docker cp "${GLM_ASR_CONTAINER_NAME}:${container_output}" "$output_file"
        docker exec "${GLM_ASR_CONTAINER_NAME}" rm -f "$container_input" "$container_output"

        echo -e "${GREEN}✓ Done: $output_file${NC}"
        ;;
    health)
        check_container || exit 1
        docker exec "${GLM_ASR_CONTAINER_NAME}" python glm_asr_cli.py health
        ;;
    status)
        if docker ps --format '{{.Names}}' | grep -q "^${GLM_ASR_CONTAINER_NAME}$"; then
            echo -e "${GREEN}● Running${NC}"
            docker ps --filter "name=${GLM_ASR_CONTAINER_NAME}" --format "  Image: {{.Image}}\n  Ports: {{.Ports}}\n  Status: {{.Status}}"
        else
            echo -e "${RED}○ Not running${NC}"
        fi
        ;;
    start)
        [ -d "$GLM_ASR_PROJECT_DIR" ] || { echo -e "${RED}Error: Set GLM_ASR_HOME to your project directory${NC}"; exit 1; }
        cd "$GLM_ASR_PROJECT_DIR" && docker compose up -d
        sleep 5 && glm-asr health
        ;;
    stop)
        [ -d "$GLM_ASR_PROJECT_DIR" ] || { echo -e "${RED}Error: Set GLM_ASR_HOME to your project directory${NC}"; exit 1; }
        cd "$GLM_ASR_PROJECT_DIR" && docker compose down
        ;;
    help|--help|-h)
        cat << 'EOF'
Usage: glm-asr <command> [options]

Commands:
  transcribe <file>  Transcribe audio/video file
  health             Check server health
  status             Show container status
  start              Start the container
  stop               Stop the container

Examples:
  glm-asr transcribe audio.mp3
  glm-asr transcribe audio.mp3 -l zh --format srt
EOF
        ;;
    *)
        echo -e "${RED}Unknown command '${1:-}'${NC}"
        echo "Run: glm-asr help"
        exit 1
        ;;
esac
